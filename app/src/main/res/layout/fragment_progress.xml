<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/canvas" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/progress_screen_title" android:textAppearance="@style/TextAppearance.FitJournal.Title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/progress_completed_note" android:textAppearance="@style/TextAppearance.FitJournal.Body" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="22dp"
            app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/outline">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:text="@string/progress_workouts_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.FitJournal.Body" />
                <TextView android:id="@+id/progress_workout_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.FitJournal.Title" />
                <TextView android:layout_marginTop="12dp" android:text="@string/progress_volume_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.FitJournal.Body" />
                <TextView android:id="@+id/progress_volume" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.FitJournal.Title" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="@string/progress_records_title" android:textAppearance="@style/TextAppearance.FitJournal.Section" />
        <TextView android:id="@+id/progress_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/progress_empty" android:textAppearance="@style/TextAppearance.FitJournal.Body" />
        <LinearLayout android:id="@+id/progress_records" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="12dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>