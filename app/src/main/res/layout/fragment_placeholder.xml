<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/canvas" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="180dp"
            android:layout_marginTop="12dp" android:background="@drawable/bg_hero">
            <ImageView android:layout_width="150dp" android:layout_height="150dp"
                android:layout_gravity="center" android:alpha="0.12"
                android:importantForAccessibility="no" android:src="@drawable/illustration_strength" />
            <ImageView android:id="@+id/placeholder_icon"
                android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center"
                android:importantForAccessibility="no" android:src="@drawable/ic_chart" app:tint="@color/accent" />
        </FrameLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:background="@drawable/bg_badge"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="7dp" android:paddingBottom="7dp"
            android:text="@string/coming_soon" android:textAppearance="@style/TextAppearance.FitJournal.Eyebrow" />
        <TextView android:id="@+id/placeholder_title"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:textAppearance="@style/TextAppearance.FitJournal.Title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/placeholder_caption"
            android:textAppearance="@style/TextAppearance.FitJournal.Section" />
        <TextView android:id="@+id/placeholder_description"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:lineSpacingExtra="4dp"
            android:textAppearance="@style/TextAppearance.FitJournal.Body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/placeholder_action"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="28dp"
            android:text="@string/explore_exercises" app:cornerRadius="16dp"
            app:icon="@drawable/ic_dumbbell" app:iconGravity="textStart" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
