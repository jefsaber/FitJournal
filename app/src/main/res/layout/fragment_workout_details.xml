<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/canvas" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/workout_details_title" android:textAppearance="@style/TextAppearance.FitJournal.Title" />
        <TextView android:id="@+id/workout_details_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textAppearance="@style/TextAppearance.FitJournal.Section" />
        <TextView android:id="@+id/workout_details_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textAppearance="@style/TextAppearance.FitJournal.Body" />
        <TextView android:id="@+id/workout_details_notes" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textAppearance="@style/TextAppearance.FitJournal.Body" />
        <ProgressBar android:id="@+id/workout_details_progress" android:layout_width="32dp" android:layout_height="32dp"
            android:layout_gravity="center_horizontal" android:layout_margin="20dp" />
        <TextView android:id="@+id/workout_details_error" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/workout_not_found" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/workout_details_retry"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/exercise_retry" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/add_entry_button"
            android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp"
            android:text="@string/workout_entry_add" />
        <TextView android:id="@+id/workout_entry_operation_error"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/workout_entry_operation_error"
            android:textColor="@color/error" android:visibility="gone" />
        <TextView android:id="@+id/workout_details_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/workout_entries_empty" android:visibility="gone"
            android:textAppearance="@style/TextAppearance.FitJournal.Body" />
        <LinearLayout android:id="@+id/workout_details_entries" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="16dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
