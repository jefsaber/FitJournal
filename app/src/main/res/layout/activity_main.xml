<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/canvas" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/main_toolbar"
        android:layout_width="match_parent" android:layout_height="@dimen/app_toolbar_height"
        android:background="@color/canvas"
        android:paddingStart="8dp" android:paddingEnd="12dp"
        app:contentInsetStartWithNavigation="8dp"
        app:navigationIconTint="@color/ink"
        app:logo="@drawable/ic_brand"
        app:subtitle="@string/brand_tagline"
        app:subtitleTextAppearance="@style/TextAppearance.FitJournal.Body"
        app:titleMarginStart="12dp"
        app:title="@string/app_name"
        app:titleTextAppearance="@style/TextAppearance.FitJournal.Brand" />
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true" app:navGraph="@navigation/nav_graph" />
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent" android:layout_height="@dimen/app_bottom_navigation_height"
        android:minHeight="@dimen/app_bottom_navigation_height"
        android:background="@color/canvas"
        app:elevation="0dp"
        app:itemIconTint="@color/nav_item_tint"
        app:itemTextColor="@color/nav_item_tint"
        app:itemTextAppearanceActive="@style/TextAppearance.FitJournal.Nav"
        app:itemTextAppearanceInactive="@style/TextAppearance.FitJournal.Nav"
        app:labelVisibilityMode="@integer/navigation_label_mode"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
